# Copy to `.env` and fill in. `.env` is gitignored; this template is committed.

# --- Database (Phase 0) ---
# PostgreSQL connection string. Local dev example:
#   postgresql://<user>@localhost:5432/bdaio_dev?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/bdaio_dev?schema=public"

# --- Auth (Phase 1) ---
# Required. Signs the session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Public origin of this deployment. Used for links in transactional emails and —
# since Phase 7 — for canonical URLs, Open Graph cards, robots.txt, and
# sitemap.xml. It is read at build time, so changing it means rebuilding.
APP_URL="http://localhost:3000"

# --- Email / SMTP (Phase 1) ---
# Until SMTP_HOST and SMTP_PORT are set, emails are logged to the server
# console instead of being sent — every flow still works end to end.
# Google Workspace: use an App Password (not the account password), no spaces.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="you@yourdomain.org"
SMTP_PASS=""
EMAIL_FROM="BdAIO <you@yourdomain.org>"

# --- Uploads (Phase 1) ---
# Local disk path for user uploads, kept outside the web root.
# In production, point nginx at this directory to serve /uploads directly.
UPLOAD_DIR="./uploads"

# --- SMS (Phase 7) ---
# Optional. Until SMS_API_URL and SMS_API_KEY are set, texts are logged rather
# than sent and nothing else changes — SMS is an extra channel, never the only
# one. Participants must also opt in on their profile.
#
# No provider is committed to yet. These variables describe the request shape
# that Bangladeshi gateways share, so most can be wired up without code:
#   SMS_API_FORMAT  form (default) | json | query
#   SMS_FIELD_*     the gateway's parameter names
# SMS_API_URL="https://api.example-gateway.com.bd/sendsms"
# SMS_API_KEY=""
# SMS_SENDER_ID="BdAIO"
# SMS_API_FORMAT="form"
# SMS_FIELD_TO="to"
# SMS_FIELD_TEXT="msg"
# SMS_FIELD_KEY="api_key"
# SMS_FIELD_SENDER="sender_id"
#
# As with email, delivery is suppressed outside production — seeded accounts have
# invented numbers, and a wrong number is a real message to a stranger, billed.
# SMS_DEV_SEND="false"

# --- Nightly housekeeping (Phase 7) ---
# Bearer token for POST /api/cron/prune, which clears expired sessions, used
# tokens, rate-limit rows, and stale analytics. Without it the endpoint 404s.
# Generate with: openssl rand -hex 32
# CRON_SECRET=""

# --- Payments / ShurjoPay (Phase 8) ---
# SHURJOPAY_USERNAME=""
# SHURJOPAY_PASSWORD=""
# SHURJOPAY_PREFIX=""
# SHURJOPAY_ENDPOINT=""

# Outside production, mail is logged rather than delivered so seed/test accounts
# (@example.com) cannot generate bounces against the real sending domain.
# Set to "true" to send for real while developing.
# EMAIL_DEV_SEND="false"

# --- Contact form (Phase 7b) ---
# Where public contact messages are emailed. Falls back to SMTP_USER. Messages
# are stored in the database regardless, so a mail outage never loses one.
# CONTACT_INBOX="bdaio@bdosn.org"

# --- Submissions (Phase 7b) ---
# Where entrants' answer files are stored. MUST NOT be inside UPLOAD_DIR, and
# nginx must never serve it: every read goes through /api/submissions/[id],
# which checks the caller is the owner, an admin, or a judge on that round.
SUBMISSION_DIR="./private-uploads/submissions"
