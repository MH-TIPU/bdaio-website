// BdAIO platform schema — Phase 0 (Foundation).
// Core identity + competition hierarchy: User, Profile, Institution, Program, Event, Round, Registration.
// The community/trust layer (memberships, roles, contributions), results, resources, payments (ShurjoPay),
// and LMS models are added in later phases — see docs/PLATFORM_PLAN.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum AccountRole {
  PARTICIPANT
  INSTITUTION_MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum ProfileVisibility {
  PRIVATE
  PUBLIC
}

enum InstitutionType {
  SCHOOL
  COLLEGE
  UNIVERSITY
  CLUB
  COMMUNITY
}

enum InstitutionStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum ProgramScope {
  LOCAL
  NATIONAL
  REGIONAL
  INTERNATIONAL
}

enum EventType {
  OLYMPIAD_EDITION
  REGIONAL_ROUND
  WORKSHOP
  SEMINAR
  COURSE
  BOOTCAMP
}

enum EventMode {
  ONLINE
  OFFLINE
  HYBRID
}

enum EventStatus {
  DRAFT
  OPEN
  RUNNING
  ARCHIVED
}

enum RegistrationStatus {
  APPLIED
  APPROVED
  REJECTED
  WAITLISTED
  WITHDRAWN
}

enum MembershipRole {
  STUDENT
  MEMBER
  VOLUNTEER
  MODERATOR
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CommunityRoleType {
  VOLUNTEER
  MENTOR
  CONTRIBUTOR
}

enum ContributionKind {
  ORGANIZING
  MENTORING
  CONTENT
  TRANSLATION
  JUDGING
  OTHER
}

enum Medal {
  GOLD
  SILVER
  BRONZE
  HONOURABLE_MENTION
}

enum CertificateType {
  PARTICIPATION
  MERIT
  MEDAL
  APPRECIATION
  COURSE
}

enum ResourceVisibility {
  PUBLIC
  MEMBERS
}

enum ResourceKind {
  SYLLABUS
  GUIDELINE
  PAST_PROBLEM
  MATERIAL
  DOWNLOAD
  LINK
}

enum BadgeType {
  VERIFIED_STUDENT
  VOLUNTEER
  MENTOR
  CONTRIBUTOR
  MEDAL
  PARTICIPATION
}

// ---------------------------------------------------------------------------
// Identity & profile
// ---------------------------------------------------------------------------

model User {
  id              String      @id @default(cuid())
  email           String      @unique
  passwordHash    String?
  role            AccountRole @default(PARTICIPANT)
  status          UserStatus  @default(PENDING)
  emailVerifiedAt DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  profile       Profile?
  registrations Registration[]
  sessions      Session[]
  tokens        AuthToken[]
  activityLogs  ActivityLog[]
  memberships   InstitutionMembership[]
  communityRoles CommunityRole[]
  contributions Contribution[]
  badges        Badge[]
  certificates  Certificate[]
  notifications Notification[]
  judgeRoles    RoundJudge[]
  contactMessages ContactMessage[]
  mediaUploads  MediaAsset[]
  enrollments   Enrollment[]

  @@index([role])
}

/// Database-backed sessions: revocable, so suspending a user or "log out
/// everywhere" takes effect immediately (a JWT-only strategy cannot do this).
model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  userAgent  String?
  ipAddress  String?

  @@index([userId])
  @@index([expiresAt])
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/// Single-use tokens for email verification and password reset. Only a hash of
/// the token is stored, so a database leak does not yield usable tokens.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

/// Drives the participant activity feed and the admin/moderator audit trail.
model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action])
}

model Profile {
  id            String            @id @default(cuid())
  userId        String            @unique
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  handle        String?           @unique // public profile URL: /u/[handle]
  fullName      String
  fullNameBn    String?
  photo         String?
  phone         String?
  dateOfBirth   DateTime?
  gender        String?
  // Present address (division → district → upazila → street).
  presentDivision String?
  presentDistrict String?
  presentUpazila  String?
  presentAddress  String?
  // Permanent ("past") address — often a different home district in Bangladesh.
  permanentDivision String?
  permanentDistrict String?
  permanentUpazila  String?
  permanentAddress  String?
  /// True when the permanent address is the same as the present one.
  sameAddress     Boolean @default(false)
  bio           String?
  visibility    ProfileVisibility @default(PRIVATE)
  /// Opt-in for transactional SMS (Phase 7). Off by default: a phone number is
  /// collected for organisers to reach a participant, which is not consent to
  /// be texted by the platform.
  smsOptIn      Boolean           @default(false)
  institutionId String?
  institution   Institution?      @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  classGrade    String?
  guardian      GuardianInfo?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([institutionId])
}

/// Guardian contact, required for participants under 18 (BdAIO is a school
/// olympiad, so most participants are minors).
model GuardianInfo {
  id        String   @id @default(cuid())
  profileId String   @unique
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  relation  String?
  phone     String
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Institution {
  id          String            @id @default(cuid())
  name        String
  nameBn      String?
  slug        String            @unique
  type        InstitutionType   @default(SCHOOL)
  division    String?
  district    String?
  upazila     String?
  logo        String?
  description String?
  website     String?
  status      InstitutionStatus @default(PENDING)
  verified    Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  profiles    Profile[]
  memberships InstitutionMembership[]

  @@index([status])
}

/// Links a person to an institution. A moderator marking a membership
/// `verified` is what grants that student the Verified Student badge — it can
/// never be self-claimed.
model InstitutionMembership {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  institutionId  String
  institution    Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  membershipRole MembershipRole @default(STUDENT)
  status         ApprovalStatus @default(PENDING)
  verified       Boolean        @default(false)
  verifiedById   String?
  verifiedAt     DateTime?
  note           String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([userId, institutionId])
  @@index([institutionId, status])
}

/// Additive, opt-in community standing shown on the public profile. Scoped to
/// an institution (moderator-approved) or global (admin-approved).
model CommunityRole {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          CommunityRoleType
  institutionId String? // null = global
  status        ApprovalStatus    @default(PENDING)
  motivation    String?
  approvedById  String?
  since         DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([userId, type, institutionId])
  @@index([status])
}

/// What a volunteer/mentor/contributor actually did. Powers the public profile.
model Contribution {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         ContributionKind @default(OTHER)
  title        String
  description  String?
  eventId      String?
  event        Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)
  occurredOn   DateTime?
  hours        Int?
  verifiedById String?
  verifiedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([userId])
}

/// A certificate issued to a participant. The PDF is generated on demand from
/// these fields, so the record — not a stored file — is the source of truth.
/// `serial` is what a third party checks to confirm a certificate is genuine.
model Certificate {
  id         String          @id @default(cuid())
  serial     String          @unique
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId    String?
  event      Event?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  type       CertificateType @default(PARTICIPATION)
  title      String
  recipientName String // captured at issue time so later profile edits cannot alter it
  detail     String?
  issuedAt   DateTime        @default(now())
  issuedById String?
  revokedAt  DateTime?

  @@index([userId])
  @@index([eventId])
}

/// In-app notification. Created by the server alongside the action it reports.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt])
}

enum AnnouncementAudience {
  EVERYONE
  MEMBERS
  MODERATORS
}

/// Site-wide notices. `publishAt` lets an announcement be prepared ahead of
/// time; nothing is visible before that moment.
model Announcement {
  id         String               @id @default(cuid())
  title      String
  titleBn    String?
  body       String
  bodyBn     String?
  audience   AnnouncementAudience @default(EVERYONE)
  pinned     Boolean              @default(false)
  published  Boolean              @default(false)
  publishAt  DateTime?
  expiresAt  DateTime?
  createdById String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([published, publishAt])
}

/// CMS-lite: editable copy for public pages, so organisers can change wording
/// without a deploy. Body is Markdown-ish plain text rendered as paragraphs.
model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  titleBn   String?
  body      String
  bodyBn    String?
  published Boolean  @default(true)
  updatedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// FAQ entries, moved out of `src/data/faq.ts` so they are editable.
model FaqItem {
  id         String   @id @default(cuid())
  /// Groups questions under a heading on the public page.
  section    String   @default("General")
  question   String
  answer     String
  order      Int      @default(0)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([published, order])
}

/// Simple key/value settings an admin can change at runtime.
///
/// The keys are not free-form: `src/lib/settings/registry.ts` declares every one
/// of them with its type, default and admin-form copy, and `getSettings()`
/// resolves a missing or unparseable row back to that default.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// The image library: every picture an organiser uploads through the admin,
/// stored once and referenced wherever it is used.
///
/// Uploads elsewhere in the platform (avatars, event banners) belong to the
/// thing they picture and are replaced with it. These do not — a sponsor logo
/// outlives the tier it was placed in, and the same logo appears in several
/// places. Hence a library with its own screen rather than a file field.
///
/// `filename` is server-generated and unique; the bytes live under
/// `UPLOAD_ROOT/media` and are re-encoded to WebP on the way in, which is what
/// makes "it decoded, so it is an image" true. Dimensions are stored because
/// `next/image` needs them and re-reading the file to find out would be silly.
model MediaAsset {
  id           String    @id @default(cuid())
  filename     String    @unique
  /// What this picture is, for the admin listing. Not shown publicly.
  title        String
  /// Alternative text, shown to assistive technology wherever it is rendered.
  /// Empty means decorative — a deliberate choice, so it is nullable rather
  /// than defaulted to the title, which would put filler in the accessible name.
  alt          String?
  width        Int
  height       Int
  sizeBytes    Int
  uploadedById String?
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  sponsors     Sponsor[]
  courses      Course[]

  @@index([createdAt])
}

/// Where a sponsor appears on the home page. The order here is the order the
/// sections are rendered in.
enum SponsorTier {
  ORGANIZER
  PLATINUM
  POWERED_BY
  GOLD
  SILVER
  BRONZE
  KNOWLEDGE
  TV
  PARTNER
  MAGAZINE
  VENUE
}

/// A sponsor's placement on the home page — not the organisation itself.
///
/// An organisation that supports us in two capacities (BUBT is both the platinum
/// sponsor and a regional venue host) is two rows pointing at one `MediaAsset`.
/// Modelling the organisation separately would buy a canonical name and cost a
/// join plus an editing screen nobody asked for; the logo, which is the part
/// that is expensive to keep in step, is already shared.
model Sponsor {
  id        String      @id @default(cuid())
  name      String
  nameBn    String?
  tier      SponsorTier
  /// Optional link out. Rendered as a plain image when absent.
  url       String?
  assetId   String?
  asset     MediaAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)
  /// Position within the tier. Ties fall back to name.
  order     Int         @default(0)
  published Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([published, tier, order])
}

enum EmailJobStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

/// One outgoing email, durable and retryable.
///
/// Sending used to happen inside the request: a password reset held the response
/// for ~5 seconds while we waited on Google's SMTP, and an SMTP blip meant the
/// mail was simply lost — the flow deliberately never throws, so nothing was
/// left to retry from. Both problems are the same problem: the only record of
/// the email lived in a stack frame.
///
/// The row is written first and the delivery attempted after the response, so
/// the user waits on a database insert instead of a mail server, and a failure
/// is a row with `attempts` and `lastError` on it rather than a line in a log.
///
/// The body is stored rendered rather than as a template name plus arguments:
/// what was sent should be what we can read back, and a template edited next
/// month must not change the meaning of a message queued today.
model EmailJob {
  id        String         @id @default(cuid())
  to        String
  subject   String
  text      String
  html      String
  replyTo   String?
  status    EmailJobStatus @default(PENDING)
  attempts  Int            @default(0)
  lastError String?
  /// Earliest time a worker may claim this job — this is the retry backoff.
  runAfter  DateTime       @default(now())
  sentAt    DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([status, runAfter])
  @@index([createdAt])
}

/// Messages sent through the public contact form.
///
/// Stored rather than only emailed: mail to a shared address gets lost, and an
/// organiser needs to see what is outstanding. `handledAt`/`handledById` is that
/// queue — not a workflow, just "someone has dealt with this".
///
/// No relation to `User`: most senders are not signed in, and asking a
/// prospective participant to create an account before they can ask a question
/// is how you never hear from them.
model ContactMessage {
  id          String    @id @default(cuid())
  name        String
  email       String
  subject     String
  body        String
  /// Set when a signed-in user sent it, so a reply has context. Nullable.
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  handledAt   DateTime?
  handledById String?
  createdAt   DateTime  @default(now())

  @@index([handledAt, createdAt])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Phase 7 — hardening (rate limiting + analytics)
// ---------------------------------------------------------------------------

/// Fixed-window rate-limit counters. Kept in Postgres rather than in process
/// memory so a pm2 restart (or a second process) cannot reset an attacker's
/// budget, and so the limit is shared across every instance.
///
/// `bucket` encodes both what is limited and who is being limited, e.g.
/// `login:ip:203.0.113.4` or `login:email:sha256(...)`. Rows are disposable:
/// anything past `expiresAt` is pruned opportunistically.
model RateLimit {
  bucket      String
  windowStart DateTime
  count       Int      @default(1)
  expiresAt   DateTime

  @@id([bucket, windowStart])
  @@index([expiresAt])
}

/// Daily page-view counts, aggregate only. There is deliberately no
/// per-request table: without raw rows there is no browsing history to leak,
/// subpoena, or forget to purge.
model PageViewDaily {
  day   DateTime @db.Date
  path  String
  views Int      @default(0)

  @@id([day, path])
  @@index([day])
}

/// One row per (day, visitor) → daily unique visitors, no cookie involved.
/// `visitorHash` is HMAC(ip + user-agent) keyed with a *per-day* secret, so it
/// cannot be reversed to an IP and the same person is not linkable across days.
model VisitorDaily {
  day         DateTime @db.Date
  visitorHash String

  @@id([day, visitorHash])
  @@index([day])
}

/// Where public traffic came from, by referrer host only — never the full
/// referring URL, which can carry a search query or a private page path.
model ReferrerDaily {
  day   DateTime @db.Date
  host  String
  count Int      @default(0)

  @@id([day, host])
  @@index([day])
}

/// Core Web Vitals rolled up per day. Stores bucket counts (Google's
/// good/needs-improvement/poor thresholds) plus sum+count for a mean, because
/// a true p75 would require keeping every sample.
model WebVitalDaily {
  day    DateTime @db.Date
  metric String
  count  Int      @default(0)
  total  Float    @default(0)
  good   Int      @default(0)
  fair   Int      @default(0)
  poor   Int      @default(0)

  @@id([day, metric])
  @@index([day])
}

model ResourceCategory {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  order     Int        @default(0)
  resources Resource[]
}

/// Syllabuses, guidelines, past problems and downloads. `MEMBERS` visibility
/// requires a signed-in account, checked server-side on both list and file.
model Resource {
  id          String             @id @default(cuid())
  title       String
  titleBn     String?
  description String?
  kind        ResourceKind       @default(MATERIAL)
  visibility  ResourceVisibility @default(PUBLIC)
  url         String? // external link
  filePath    String? // stored under UPLOAD_DIR
  categoryId  String?
  category    ResourceCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  published   Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([visibility, published])
}

// ---------------------------------------------------------------------------
// Phase 9 — LMS
//
// Deliberately its own hierarchy rather than an extension of Event/Round. An
// event happens on a date and everyone sits it together; a course is taken at
// the learner's own pace and has no capacity, no venue and no judges. Forcing
// the two together would have meant a `Registration` whose window fields were
// always null and a `Round` that never ran — the shapes only look alike.
//
// What *is* reused: certificates go through the existing pipeline (a `COURSE`
// certificate is verified at `/verify/[serial]` exactly like a competition one),
// visibility follows `ResourceVisibility`, and cover images come from the media
// library.
// ---------------------------------------------------------------------------

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonKind {
  /// Prose written in the admin, rendered on the page.
  TEXT
  /// An embedded video, with the prose as its notes.
  VIDEO
  /// A link out — a Kaggle notebook, a dataset, someone else's tutorial.
  EXTERNAL
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  WITHDRAWN
}

model Course {
  id          String             @id @default(cuid())
  title       String
  titleBn     String?
  slug        String             @unique
  /// One or two lines for the course card.
  summary     String?
  summaryBn   String?
  description String?
  level       CourseLevel        @default(BEGINNER)
  status      CourseStatus       @default(DRAFT)
  visibility  ResourceVisibility @default(PUBLIC)
  coverId     String?
  cover       MediaAsset?        @relation(fields: [coverId], references: [id], onDelete: SetNull)
  /// Issue a certificate when every lesson is done and every quiz passed.
  certificate Boolean            @default(false)
  order       Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  modules     CourseModule[]
  enrollments Enrollment[]

  @@index([status, visibility])
}

model CourseModule {
  id       String   @id @default(cuid())
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  titleBn  String?
  order    Int      @default(0)
  lessons  Lesson[]

  @@index([courseId, order])
}

model Lesson {
  id       String       @id @default(cuid())
  moduleId String
  module   CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title    String
  titleBn  String?
  kind     LessonKind   @default(TEXT)
  /// Prose for TEXT, notes for VIDEO. Plain text with blank-line paragraphs —
  /// the same shape as `Page.body`, for the same reason: an organiser is not
  /// going to learn a markup language to publish a lesson.
  body     String?
  bodyBn   String?
  /// VIDEO: the embed URL. EXTERNAL: where the link goes.
  url      String?
  /// Rough reading/watching time, shown so a learner can plan a sitting.
  minutes  Int?
  order    Int          @default(0)

  quiz     Quiz?
  progress LessonProgress[]

  @@index([moduleId, order])
}

/// One enrolment of one person on one course.
///
/// Separate from `Registration` on purpose (see the note above), and the anchor
/// for progress: deleting an enrolment takes its progress and attempts with it,
/// which is what "withdraw and start again" should mean.
model Enrollment {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status        EnrollmentStatus @default(ACTIVE)
  startedAt     DateTime         @default(now())
  completedAt   DateTime?
  /// The certificate issued on completion, if the course grants one.
  certificateId String?
  progress      LessonProgress[]
  attempts      QuizAttempt[]

  @@unique([userId, courseId])
  @@index([courseId, status])
}

model LessonProgress {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt  DateTime   @default(now())

  @@unique([enrollmentId, lessonId])
  @@index([lessonId])
}

/// A check at the end of a lesson. One per lesson, or none.
model Quiz {
  id       String     @id @default(cuid())
  lessonId String     @unique
  lesson   Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title    String     @default("Check your understanding")
  /// Percentage needed to pass. A course certificate requires every quiz passed.
  passMark Int        @default(60)
  questions Question[]
  attempts  QuizAttempt[]
}

model Question {
  id       String           @id @default(cuid())
  quizId   String
  quiz     Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  prompt   String
  promptBn String?
  order    Int              @default(0)
  options  QuestionOption[]

  @@index([quizId, order])
}

/// An answer option.
///
/// `isCorrect` lives here rather than as an index on the question so a quiz can
/// have more than one right answer later without a migration — and so no query
/// that selects options for display can accidentally include the key, because
/// selecting it has to be deliberate.
model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  textBn     String?
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)

  @@index([questionId, order])
}

model QuizAttempt {
  id           String     @id @default(cuid())
  quizId       String
  quiz         Quiz       @relation(fields: [quizId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  /// Percentage, rounded.
  score        Int
  passed       Boolean
  createdAt    DateTime   @default(now())

  @@index([enrollmentId, quizId])
}

/// Earned marks shown publicly: system badges (verified student, roles) and
/// competition results. Granted by the server, never by the holder.
model Badge {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      BadgeType
  title     String
  eventId   String?
  event     Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  awardedAt DateTime  @default(now())

  @@unique([userId, type, eventId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Competition hierarchy: Program -> Event -> Round, with Registration
// ---------------------------------------------------------------------------

model Program {
  id          String       @id @default(cuid())
  title       String
  titleBn     String?
  slug        String       @unique
  description String?
  logo        String?
  scope       ProgramScope @default(NATIONAL)
  isExternal  Boolean      @default(false) // we host it vs merely nominate students to it
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  events Event[]
}

model Event {
  id          String      @id @default(cuid())
  programId   String
  program     Program     @relation(fields: [programId], references: [id], onDelete: Cascade)
  title       String
  titleBn     String?
  slug        String      @unique
  type        EventType   @default(OLYMPIAD_EDITION)
  year        Int
  description String?
  mode        EventMode   @default(OFFLINE)
  venue       String?
  onlineUrl   String?
  capacity    Int?
  feeBdt      Int? // null = free
  banner      String?
  status      EventStatus @default(DRAFT)
  startsAt    DateTime?
  endsAt      DateTime?
  regOpensAt  DateTime?
  regClosesAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  rounds        Round[]
  registrations Registration[]
  contributions Contribution[]
  badges        Badge[]
  certificates  Certificate[]

  @@index([programId])
  @@index([type])
  @@index([status])
}

model Round {
  id          String    @id @default(cuid())
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  order       Int       @default(0)
  mode        EventMode @default(OFFLINE)
  venue       String?
  onlineUrl   String?
  startsAt    DateTime?
  endsAt      DateTime?
  regOpensAt  DateTime?
  regClosesAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// Submissions are off unless an organiser turns them on for this round: most
  /// rounds are marked from an offline sitting and should not invite uploads.
  allowSubmissions   Boolean   @default(false)
  /// The window entrants may upload in. Separate from `startsAt`/`endsAt`, which
  /// describe when the round is *sat* — a take-home task is often collected
  /// hours after the paper closes.
  submissionsOpenAt  DateTime?
  submissionsCloseAt DateTime?

  registrations Registration[]
  judges        RoundJudge[]
  results       Result[]
  submissions   Submission[]

  @@index([eventId])
}

/// An entrant's answer file for a round.
///
/// One row per (registration, round): re-uploading **replaces** the file, which
/// matches how an exam works — the latest submission is the answer. There is
/// deliberately no version history; keeping every draft of every entrant's work
/// is a storage and privacy cost with no marking benefit.
model Submission {
  id             String       @id @default(cuid())
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  roundId        String
  round          Round        @relation(fields: [roundId], references: [id], onDelete: Cascade)
  /// Server-generated name on disk. A client filename never reaches a path.
  filename       String
  /// What the entrant called it, shown in the UI and used as the download name.
  originalName   String
  mimeType       String
  sizeBytes      Int
  /// Optional note from the entrant — a Kaggle link, or what they attempted.
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([registrationId, roundId])
  @@index([roundId])
}

/// A judge assigned to a specific round. Scoping by round is what stops a judge
/// for one round from touching another round's marks.
model RoundJudge {
  id         String   @id @default(cuid())
  roundId    String
  round      Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([roundId, userId])
  @@index([userId])
}

/// One participant's outcome in one round.
///
/// `published` is the gate: until an admin publishes, a result is invisible to
/// the participant and to the public, so partial marking is never leaked.
model Result {
  id             String    @id @default(cuid())
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  roundId        String
  round          Round     @relation(fields: [roundId], references: [id], onDelete: Cascade)
  marks          Float?
  maxMarks       Float?
  rank           Int?
  medal          Medal?
  remarks        String?
  published      Boolean   @default(false)
  publishedAt    DateTime?
  scoredById     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([registrationId, roundId])
  @@index([roundId, published])
}

model Registration {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String
  event     Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  roundId   String?
  round     Round?             @relation(fields: [roundId], references: [id], onDelete: SetNull)
  status    RegistrationStatus @default(APPLIED)
  category  String? // age-group / category label
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  results     Result[]
  submissions Submission[]

  @@unique([userId, eventId, roundId])
  @@index([eventId])
  @@index([userId])
}
